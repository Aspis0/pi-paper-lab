{
  "name": "pi-paper-lab",
  "version": "0.6.1",
  "description": "Writing-style guardrails for scientific text in pi. Anti-AI rewrite, automatic Vancouver citations, .docx output. Domain-agnostic (Drosophila, mouse, cancer, C. elegans, neuroscience, custom YAML profiles).",
  "type": "module",
  "main": "extensions/index.ts",
  "files": [
    "extensions",
    "src",
    "data",
    "README.md",
    "PLAN-AGNOSTIC.md",
    "PLAN-STUDY-PHASE.md",
    "PLAN-EXA-BACKEND.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/anti-ai-lexicon.test.ts",
    "audit": "npm audit --audit-level=high",
    "prepack": "npm run typecheck && npm test && npm run audit"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "extension",
    "scientific-writing",
    "anti-ai",
    "citations",
    "drosophila",
    "mouse",
    "cancer",
    "biology",
    "docx"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aspis0/pi-paper-lab.git"
  },
  "bugs": {
    "url": "https://github.com/Aspis0/pi-paper-lab/issues"
  },
  "homepage": "https://github.com/Aspis0/pi-paper-lab#readme",
  "engines": {
    "node": ">=22.7"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "js-yaml": "^4.1.0",
    "typebox": "^1.0.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "@earendil-works/pi-coding-agent": {
      "brace-expansion": "^5.0.8"
    }
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
